# =============================================================================
# ULTIMATE LOCAL AI STACK - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values
# Generate secrets with: openssl rand -base64 32
# =============================================================================

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
DOMAIN=manixsystems.cloud
TIMEZONE=America/New_York
NODE_ENV=production

# =============================================================================
# URLS - UPDATE THESE FOR YOUR ENVIRONMENT
# =============================================================================
# For local development: use localhost
# For Tailscale access: use your Tailscale IP (e.g., 100.100.180.114)
# For public access: use your domain

# Main API Gateway URL (Kong) - This is the entry point for Supabase APIs
API_EXTERNAL_URL=http://100.100.180.114:8000

# Your frontend application URL
SITE_URL=http://manixsystems.cloud

# =============================================================================
# SUPABASE - PostgreSQL
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=qajLZzJLXAgpjo4YTvGdRiRh
POSTGRES_DB=postgres

# =============================================================================
# SUPABASE - Authentication (GoTrue)
# =============================================================================
# JWT Secret - MUST be at least 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=5id2ACp98YiQYYN19cw5IG5VagNRceKEGc0wi3IQ
JWT_EXPIRY=3600

# These are derived from JWT_SECRET using jwt.io or supabase CLI
