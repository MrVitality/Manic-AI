# =============================================================================
# Manic-AI Environment Variables
# Copy this file to .env and fill in required values before running docker-compose
# =============================================================================

# Network binding
# SECURITY: Use 127.0.0.1 (localhost only) unless you have a reverse proxy handling external traffic.
# 0.0.0.0 exposes Postgres, Redis, Qdrant, and Ollama directly to the network — dev only.
BIND_IP=127.0.0.1

# =============================================================================
# PostgreSQL / Supabase
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=              # REQUIRED: set a strong password
POSTGRES_DB=postgres

# Supabase API Keys — MUST be regenerated per deployment
# Generate at: https://supabase.com/docs/guides/self-hosting#api-keys
ANON_KEY=                       # REQUIRED: JWT for anon role
SERVICE_ROLE_KEY=               # REQUIRED: JWT for service_role
# JWT_SECRET=                   # Used to sign both keys above

# =============================================================================
# Redis
# =============================================================================
REDIS_PASSWORD=                 # REQUIRED: set a strong password (used by docker-compose redis command)

# =============================================================================
# Qdrant
# =============================================================================
QDRANT_API_KEY=                 # REQUIRED: set any secret string to enable Qdrant API key auth

# =============================================================================
# API (FastAPI)
# =============================================================================
CHAT_MODEL=llama3.2:3b
# BGE-M3 embedding model (1024 dims). Run: ollama pull bge-m3
# Migration note: if upgrading from nomic-embed-text (768 dims), you must
# re-embed existing documents or recreate vector collections with the new dimension.
EMBEDDING_MODEL=bge-m3
VECTOR_DIMENSION=1024
# Legacy reference (previous default): nomic-embed-text with VECTOR_DIMENSION=768
RAG_TOP_K=5
RAG_THRESHOLD=0.7
RAG_KEYWORD_WEIGHT=0.3
# CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Frontend (Next.js)
# =============================================================================
# These are auto-set in docker-compose.yml via BIND_IP
# NEXT_PUBLIC_API_URL=http://localhost:8081
# NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:8001
# NEXT_PUBLIC_SUPABASE_ANON_KEY=                # same as ANON_KEY above

# =============================================================================
# n8n (Workflow Automation)
# =============================================================================
N8N_USER=admin
N8N_PASSWORD=                   # REQUIRED: set a strong password

# =============================================================================
# SearXNG
# =============================================================================
SEARXNG_SECRET_KEY=             # REQUIRED: generate with: openssl rand -hex 32

# =============================================================================
# Kong / Supabase Gateway
# =============================================================================
KONG_CORS_ORIGINS=http://localhost:3000  # Comma-separated allowed origins for CORS

# =============================================================================
# Flowise (LLM Flow Builder)
# =============================================================================
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=               # REQUIRED: set a strong password

# =============================================================================
# Langfuse (LLM Tracing)
# =============================================================================
LANGFUSE_DB_PASSWORD=           # REQUIRED: Langfuse PostgreSQL password
LANGFUSE_SECRET=                # REQUIRED: NextAuth secret for Langfuse
LANGFUSE_SALT=                  # REQUIRED: encryption salt
LANGFUSE_PUBLIC_KEY=            # Optional: for API tracing from the API service
LANGFUSE_SECRET_KEY=            # Optional: for API tracing from the API service

# =============================================================================
# Obsidian AI Agent (Paddy) - Sidecar
# =============================================================================
OBSIDIAN_VAULT_PATH=            # Path to your Obsidian vault directory (e.g., /home/user/MyVault)
ANTHROPIC_API_KEY=              # Required for Paddy agent (Claude)
# RAG pipeline defaults to Ollama embeddings (no OpenAI key needed)
# EMBEDDING_BASE_URL=http://ollama:11434/v1
# EMBEDDING_MODEL_CHOICE=nomic-embed-text
