# =============================================================================
# Manic AI - Environment Variables
# =============================================================================
# Copy this file: cp .env.example .env
# Then fill in required values marked with REQUIRED
# =============================================================================

# --- Core ---
BIND_IP=0.0.0.0

# --- Database (REQUIRED) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=postgres

# Supabase JWT keys — generate with: npx supabase gen keys
ANON_KEY=
SERVICE_ROLE_KEY=
KONG_CORS_ORIGINS=http://localhost:3000

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- Qdrant (REQUIRED) ---
QDRANT_API_KEY=CHANGE_ME_qdrant_api_key

# --- API Authentication (REQUIRED) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=CHANGE_ME_api_secret_key
# Set to "multi_user" for per-user auth, "single" for shared API key
# AUTH_MODE=single

# --- Supabase Auth ---
# GOTRUE_JWT_SECRET=
# GOTRUE_API_KEY=
# GOTRUE_SITE_URL=http://localhost:3000
# GOTRUE_MAILER_AUTOCONFIRM=true

# --- SearXNG (REQUIRED) ---
SEARXNG_SECRET_KEY=CHANGE_ME_searxng_secret

# --- n8n ---
# N8N_USER=admin
# N8N_PASSWORD=CHANGE_ME
# N8N_WEBHOOK_URL=http://localhost:5679/
# N8N_SECURE_COOKIE=false

# --- Flowise ---
# FLOWISE_USERNAME=admin
# FLOWISE_PASSWORD=CHANGE_ME

# --- Langfuse ---
LANGFUSE_DB_PASSWORD=CHANGE_ME_langfuse_db_password
# LANGFUSE_SECRET=
# LANGFUSE_SALT=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- Grafana (REQUIRED) ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

# --- AI Inference ---
# INFERENCE_BACKEND=ollama
# CHAT_MODEL=llama3.2:3b
# EMBEDDING_MODEL=bge-m3
# VECTOR_DIMENSION=1024
# OPENAI_API_KEY=
ANTHROPIC_API_KEY=CHANGE_ME_if_using_anthropic
# VLLM_URL=
# VLLM_MODEL=
# MODEL_FALLBACK_CHAIN=ollama,openai,anthropic

# --- RAG Settings ---
# RAG_TOP_K=5
# RAG_THRESHOLD=0.7
# RAG_KEYWORD_WEIGHT=0.3

# --- Frontend / CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# --- Obsidian Agent ---
# OBSIDIAN_VAULT_PATH=./obsidian-vault
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL_CHOICE=bge-m3
# RAG_PIPELINE_ID=

# --- Observability ---
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://ai-jaeger:4317
